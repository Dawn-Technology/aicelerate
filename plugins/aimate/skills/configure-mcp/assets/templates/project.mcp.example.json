{
  "mcpServers": {
    "github-client": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "atlassian-client": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "figma-client": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "sentry-client": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "playwright-client": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.79"],
      "tools": ["*"]
    }
  }
}
